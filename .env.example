# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored and MUST NOT be committed.
# The app does not auto-load .env (no python-dotenv dependency); export it with:
#     set -a && . ./.env && set +a
# ---------------------------------------------------------------------------

# development | testing | production
APP_ENV=development

# --- Secrets ---------------------------------------------------------------
# REQUIRED in production (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside production a random per-process key is generated when this is empty.
JWT_SECRET_KEY=
SECRET_KEY=

# --- Tokens ----------------------------------------------------------------
JWT_ISSUER=lab1-secure-rest-api
JWT_AUDIENCE=lab1-secure-rest-api-clients
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
JWT_LEEWAY_SECONDS=5

# --- Password hashing ------------------------------------------------------
# bcrypt cost factor. 12 is the production default; the test suite uses 4.
BCRYPT_ROUNDS=12

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///app.db
AUTO_CREATE_TABLES=true
SQLALCHEMY_ECHO=false

# --- Rate limiting ---------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_LOGIN=5 per minute;20 per hour
RATELIMIT_REGISTER=5 per hour

# --- Transport / browser hardening -----------------------------------------
# Comma-separated allow-list; empty means "no cross-origin access".
CORS_ORIGINS=
ENABLE_HSTS=false
MAX_CONTENT_LENGTH=65536

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
JSON_LOGGING=true
